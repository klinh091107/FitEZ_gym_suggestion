# Copy this file to .env and fill in your own values. Never commit .env.

# Local: leave empty to use the SQLite file fitez.db.
# Cloud: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# Signs the login session cookie. Leave empty locally (the app creates one).
# Required when DATABASE_URL is set. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to true only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false

# Optional: also run the database tests on this PostgreSQL database.
TEST_DATABASE_URL=
